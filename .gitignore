# Ignore Windows executables
*.exe

# Ignore common compiled outputs
*.out
*.o
*.obj

# Ignore all files without an extension
*

# Re-include directories
!*/

# Re-include source and important files
!*.cpp
!*.c
!*.h
!*.hpp
!*.md
!*.txt
!*.json
!*.yml
!*.yaml
!.gitignore

# Ignore editor metadata
.vscode/
.obsidian/